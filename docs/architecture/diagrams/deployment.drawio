<mxfile host="app.diagrams.net">
  <diagram name="deployment" id="deployment">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= Node 1: Developer workstation ================= -->
        <mxCell id="node-devbox" value="Developer workstation (Windows 11)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;verticalAlign=top;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="620" height="420" as="geometry" />
        </mxCell>

        <mxCell id="box-cpython" value="CPython 3.14.4 + pygame (execution environment): runs 'python main.py' with working directory set to the repository root" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="box-repo" value="Repository (artifact): main.py, module/, pics/, main.spec" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="box-pyinstaller" value="PyInstaller (build tool): driven by main.spec" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="box-dist-out" value="dist/main/ (build output, onedir) - plus build/ intermediates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="280" width="240" height="100" as="geometry" />
        </mxCell>

        <!-- runs main.py -->
        <mxCell id="e-cpython-repo" value="python main.py" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;fontSize=10;" edge="1" parent="1" source="box-cpython" target="box-repo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- build arrow chain: Repository -> PyInstaller -> dist/main/ -->
        <mxCell id="e-repo-pyinstaller" value="build" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;fontSize=10;" edge="1" parent="1" source="box-repo" target="box-pyinstaller">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-pyinstaller-dist" value="produces" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;fontSize=10;" edge="1" parent="1" source="box-pyinstaller" target="box-dist-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note: python version mismatch -->
        <mxCell id="note-pyver" value="Built against CPython 3.9; the developer's current interpreter is 3.14.4." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;size=16;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="100" width="300" height="100" as="geometry" />
        </mxCell>

        <!-- ================= Node 2: Player machine ================= -->
        <mxCell id="node-playerbox" value="Player machine (Windows)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;verticalAlign=top;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="620" height="340" as="geometry" />
        </mxCell>

        <mxCell id="box-distmain" value="dist/main/ (artifact)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="620" width="500" height="220" as="geometry" />
        </mxCell>

        <mxCell id="box-mainexe" value="main.exe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="680" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="box-dlls" value="python39.dll, base_library.zip, SDL2.dll, SDL2_image.dll, SDL2_ttf.dll, SDL2_mixer.dll, VCRUNTIME140.dll, pygame/*.pyd" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="680" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- NOT BUNDLED pics -->
        <mxCell id="box-pics-notbundled" value="pics/ - NOT BUNDLED" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeColor=#FF0000;fillColor=none;fontColor=#FF0000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="680" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e-mainexe-pics" value="requires at runtime, resolved against the working directory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endSize=10;fontSize=10;" edge="1" parent="1" source="box-mainexe" target="box-pics-notbundled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- deploy / copy edge from build output to player machine artifact -->
        <mxCell id="e-dist-deploy" value="copy to player machine" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endSize=10;fontSize=10;" edge="1" parent="1" source="box-dist-out" target="box-distmain">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note: missing datas, hard-coded pathex, console window -->
        <mxCell id="note-spec" value="main.spec declares datas=[], so the assets are missing from the bundle: main.exe only starts from a directory that happens to contain pics/. pathex also still points at C:\Users\Umschueler\..., and console=True opens a console window beside the game." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;size=16;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="820" width="340" height="160" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
